[Unit]
Description=Run the GroundCloud vs FedEx reconciliation every 15 minutes

[Timer]
OnCalendar=*-*-* *:00,15,30,45:00
# Run promptly after boot too if the server was down when a firing was missed.
Persistent=true
# Avoid landing on exactly :00 together with other every 15 minutes jobs.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
