[Unit]
Description=Run the GroundCloud vs FedEx reconciliation hourly

[Timer]
OnCalendar=*-*-* *:00:00
# Run promptly after boot too if the server was down when a firing was missed.
Persistent=true
# Avoid landing on exactly :00 together with other hourly jobs.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
