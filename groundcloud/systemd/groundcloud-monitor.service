[Unit]
Description=GroundCloud vs FedEx pickup reconciliation (one-shot, triggered every 15 minutes by groundcloud-monitor.timer)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/fedex/groundcloud
EnvironmentFile=/root/fedex/.env
Environment=PYTHONUNBUFFERED=1
# Never let a stuck run linger or compete with the live FedEx monitor.
TimeoutStartSec=300
Nice=15
# Same venv fedex-monitor.service uses (confirmed 2026-10-20 via
# `systemctl cat fedex-monitor.service`) -- has pandas/playwright/etc.
# already installed, unlike the bare system python3.
ExecStart=/root/fedex/venv/bin/python3 /root/fedex/groundcloud/groundcloud_monitor.py

[Install]
WantedBy=multi-user.target
