# Copy to /root/fedex/.env and fill in. Never commit the real .env.
FEDEX_USERNAME=
FEDEX_PASSWORD=
# Slack: at-risk alerts (incoming webhook) and Daily Manifest (bot token + channel id)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_DAILY_CHANNEL=
# healthchecks.io ping URL for the "fedex" check
HEALTHCHECK_URL=
# GroundCloud reconciliation (same bot token as above)
GROUNDCLOUD_USERNAME=
GROUNDCLOUD_PASSWORD=
SLACK_GC_CHANNEL=C0CAS5GCS1Y
